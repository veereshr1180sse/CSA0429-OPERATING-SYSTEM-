#include <stdio.h>

int main() {
    int bt[3] = {4, 3, 5}, pr[3] = {2, 1, 3};

    for (int i = 0; i < 3; i++)
        for (int j = i + 1; j < 3; j++)
            if (pr[i] > pr[j]) {
                int t = pr[i]; pr[i] = pr[j]; pr[j] = t;
                t = bt[i]; bt[i] = bt[j]; bt[j] = t;
            }

    for (int i = 0; i < 3; i++)
        printf("P%d Priority=%d\n", i+1, pr[i]);
    return 0;
}
