#include <sys/msg.h>
#include <stdio.h>

struct msg {
    long type;
    char text[50];
};

int main() {
    int msgid = msgget(IPC_PRIVATE, 0666 | IPC_CREAT);
    struct msg m = {1, "Hello Message Queue"};

    msgsnd(msgid, &m, sizeof(m.text), 0);
    msgrcv(msgid, &m, sizeof(m.text), 1, 0);

    printf("%s\n", m.text);
    msgctl(msgid, IPC_RMID, NULL);
    return 0;
}
