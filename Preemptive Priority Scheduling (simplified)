#include <stdio.h>

int main() {
    int bt[3] = {5, 3, 1}, pr[3] = {2, 1, 3};
    int time = 0;

    while (1) {
        int min = 999, p = -1;
        for (int i = 0; i < 3; i++)
            if (bt[i] > 0 && pr[i] < min) {
                min = pr[i];
                p = i;
            }

        if (p == -1) break;
        bt[p]--;
        time++;
        printf("Time %d: P%d\n", time, p+1);
    }
    return 0;
}
