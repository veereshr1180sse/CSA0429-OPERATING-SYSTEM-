#include <stdio.h>

int main() {
    int bt[3] = {7, 2, 4};

    for (int i = 0; i < 3; i++)
        for (int j = i + 1; j < 3; j++)
            if (bt[i] > bt[j]) {
                int t = bt[i];
                bt[i] = bt[j];
                bt[j] = t;
            }

    for (int i = 0; i < 3; i++)
        printf("P%d executes with BT=%d\n", i+1, bt[i]);
    return 0;
}
